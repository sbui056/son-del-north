{
  "manifest_version": 3,
  "name": "Sidenote",
  "version": "0.1.0",
  "description": "Puts a short note under images that are known fakes or edited versions of real photos.",
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://*.reddit.com/*",
    "https://pbs.twimg.com/*",
    "https://*.redd.it/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://*.reddit.com/*",
        "http://localhost:8000/demo/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "card.css"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.reddit.com/*",
        "https://*.reddit.com/*",
        "http://localhost:8000/*"
      ]
    }
  ]
}
